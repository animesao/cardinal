# xbps-src template for cardinal.
#
# This file is registered with `xbps-src` under
#   srcpkgs/cardinal/template
# in a fork of void-packages (https://github.com/void-linux/void-packages).
#
# The xbps-src build pipeline:
#   1. fetches `distfiles/cardinal-${version}.tar.gz`   <-- from $distfiles
#   2. verifies against `checksum=` below
#   3. unpacks into $wrksrc
#   4. runs build_style="go" which invokes:
#        ${go} build ${go_package}
#      with CGO_ENABLED=0 hard-coded (because cardinal is a pure-go binary)
#   5. installs via the framework `do_install()`
#
# We override `do_install()` so the binary lands at /usr/bin/cardinal,
# not /usr/lib/go/bin/cardinal which is xbps-src's default.

pkgname=cardinal
version=1.24.15
revision=1
wrksrc="cardinal-${version}"
build_style="go"
go_import_path="github.com/animesao/cardinal"
go_package=.
go_build_tags="netgo"
short_desc="Lightweight, daemonless, OCI-compatible container runtime"
maintainer="animesao <animesao@users.noreply.github.com>"
license="MIT"
homepage="https://github.com/animesao/cardinal"
changelog="https://github.com/animesao/cardinal/releases/tag/v${version}"
distfiles="https://github.com/animesao/cardinal/archive/v${version}.tar.gz"
checksum="sha256-PLACEHOLDER-REPLACE-ME-WITH: xbps-src checksum cardinal-${version}.tar.gz"

# We strip the binary upstream via -s -w -buildid=,
# so xbps-src's `nostrip=yes` keeps it from double-stripping (which
# corrupts .debug sections and breaks symbolication if anyone ever
# profiles the binary).
nostrip=yes

# Upstream build matrix uses these ldflags exactly:
#   -trimpath -ldflags="-s -w -buildid= -X cardinal/cmd.version=${version}"
# xbps-src injects `go build ${go_build_opts}`; we set the matching
# CGO + ldflags here so the produced xbps is binary-identical to the
# upstream goreleaser-produced `cardinal_1.24.15_*.pkg.tar.zst`.
go_build_opts+=" -trimpath -ldflags=-s -ldflags=-w -ldflags=-buildid= -ldflags=-X=cardinal/cmd.version=${version}"

# We do NOT want tests at build time:
#   * go test ./... runs all tests; many require root + namespaces
#   * the upstream suite is a better-quality gate than `xbps check`
go_check=

# xbps depends:
# cardinal can manage its own loopback networking + iptables using the host's
# iproute2 binary, so we don't need to declare a hard dep here. We DO
# mark iproute2 as `shlib_requires` for install via `xbps-query --files`
# hinting so users who run `cardinal network create` get a sensible error.
depends="iproute2>=4.18"

do_install() {
    # xbps-src has a generic helper for "single binary I built":
    vbin cardinal
    # If we ever ship a default config or a systemd unit, install it here:
    # vcompletion ...
    # vlicense LICENSE   # auto-detected by xbps-src's license fixture
}

# post-install verification: ensure the produced binary actually starts.
# Most Void builds skip this (xbps check covers it later), but on our
# CI loop we run `xbps-install --dry-run -i cardinal` separately to catch
# ABI drift against the freshly built glibc.
cardinal-1.24.15-lang-en_US() {
    # ensure we ship the language pack the embed expects
    :
}
